<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Dashboard">

        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_logo2"
                android:layout_gravity="center"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="150dp"

            android:layout_marginEnd="25dp"
            android:layout_marginStart="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="20sp"
                android:text="Makan dan Minum Apa Hari Ini?"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textSize="18sp"
                android:text="Pilih jenis resep di sini"/>

            <!-- Content Cards -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card 1: Makanan -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="200dp">

                            <!-- Image -->
                            <ImageView
                                android:id="@+id/cmakanan"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/makanan" />

                            <!-- Text -->
                            <TextView
                                android:id="@+id/lblmakanan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:fontFamily="@font/poppins_medium"
                                android:background="@color/primary"
                                android:text="Makanan"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:padding="8dp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: Minuman -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="200dp">

                            <!-- Image -->
                            <ImageView
                                android:id="@+id/cminuman"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/minuman" />

                            <!-- Text -->
                            <TextView
                                android:id="@+id/lblminuman"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:background="@color/primary"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Minuman"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:padding="8dp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 3: Roti & Kue -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="200dp">

                            <!-- Image -->
                            <ImageView
                                android:id="@+id/cbolukue"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bolu_kue" />

                            <!-- Text -->
                            <TextView
                                android:id="@+id/lblbolukue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:background="@color/primary"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Roti dan Kue"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:padding="8dp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@color/nav"
        android:layout_marginTop="800dp">

        <ImageView
            android:id="@+id/navhome"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/navhome"
            android:layout_marginStart="45dp"/>
        <ImageView
            android:id="@+id/navfav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/favadd"
            android:layout_marginStart="105dp"/>
        <ImageView
            android:id="@+id/navprof"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_profile"
            android:layout_marginStart="105dp"/>
    </LinearLayout>
    </RelativeLayout>