<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BoluKue">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="100dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_logo2"
            android:layout_gravity="center"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:layout_marginStart="25dp"
        android:orientation="vertical"
        android:layout_marginTop="150dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="20sp"
            android:text="Pilihan Bolu dan Kue Yang Enak!"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textSize="18sp"
            android:text="Pilih bolu atau kue di sini"/>

        <!-- BoluKue List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BoluKue Item 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/dklepon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/imm1"
                            android:layout_width="70dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center_vertical"
                            android:scaleType="centerCrop"
                            android:src="@drawable/klepon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Klepon"
                                android:fontFamily="@font/poppins_semibold"
                                android:textSize="16sp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="30dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="40 Menit"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_time"
                                    android:drawablePadding="4dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="100 Kkal"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_kkal"
                                    android:drawablePadding="4dp"
                                    android:layout_marginStart="16dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/mmfav1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/favorite"
                            android:contentDescription="Favorite Icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BoluKue Item 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/dlupis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/imm2"
                            android:layout_width="70dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center_vertical"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lupis" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lupis"
                                android:fontFamily="@font/poppins_semibold"
                                android:textSize="16sp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="30dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="75 Menit"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_time"
                                    android:drawablePadding="4dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="200 Kkal"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_kkal"
                                    android:drawablePadding="4dp"
                                    android:layout_marginStart="16dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/mmfav2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/favorite"
                            android:contentDescription="Favorite Icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BoluKue Item 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/dbrownies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/imm3"
                            android:layout_width="70dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center_vertical"
                            android:scaleType="centerCrop"
                            android:src="@drawable/brow" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Brownies"
                                android:fontFamily="@font/poppins_semibold"
                                android:textSize="16sp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="30dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="30 Menit"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_time"
                                    android:drawablePadding="4dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="170 Kkal"
                                    android:textSize="14sp"
                                    android:textColor="#868686"
                                    android:drawableLeft="@drawable/ic_kkal"
                                    android:drawablePadding="4dp"
                                    android:layout_marginStart="16dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/mmfav3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/favorite"
                            android:contentDescription="Favorite Icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@color/nav"
        android:layout_marginTop="800dp">

        <ImageView
            android:id="@+id/navhome"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/navhome"
            android:layout_marginStart="45dp"/>
        <ImageView
            android:id="@+id/navfav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/favadd"
            android:layout_marginStart="105dp"/>
        <ImageView
            android:id="@+id/navprof"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_profile"
            android:layout_marginStart="105dp"/>
    </LinearLayout>

</RelativeLayout>